# External reference clone (not our code; re-fetch via
# git clone https://github.com/idris-lang/Idris2.git idris2-src)
/idris2-src/

# Generated install prefix (idris2api + rc2 runtime install output)
/install/

# Per-package local install prefixes (e.g. libs/*/.local-install/),
# used when the default Idris2 package location is a read-only nix
# store and a package needs `idris2 --install` into something writable
.local-install/

# Build artifacts
/env.sh
build/
*.o
*.so
*.a

# verify.sh/bench.sh own log output
rc2/tests/verify-*.log
rc2/tests/bench-*.log
rc2/tests/refc-suite/**/*.log
rc2/tests/refc-suite/**/*.out
