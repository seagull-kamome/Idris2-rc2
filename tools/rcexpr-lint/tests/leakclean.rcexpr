def TestCleanErasedAlt  (fun args= ["v1:Boxed"] ret= Boxed)
  case v1 of
    _builtin.NIL [nil] tag= Just 0 args= [] ->
      [__]
    _builtin.CONS [cons] tag= Just 1 args= [v2, v3] ->
      dup v2
      drop [v1]
      v2

def TestCleanExemptChar  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  cmp ==Char [v1, #'a']
  then
    drop [v2]
    #1
  else
    v2

def TestCleanImmortalLet  (fun args= [] ret= Boxed)
  let v1 : Boxed =
    #"hello"
  #0

def TestCleanValueCase  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  let v3 : Boxed =
    case v1 of
      _builtin.NIL [nil] tag= Just 0 args= [] ->
        v2
      _builtin.CONS [cons] tag= Just 1 args= [v4, v5] ->
        drop [v1]
        v2
  v3

def TestCleanLoop  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  loop ["v1:Boxed"] initial= [v1]
  case v1 of
    _builtin.CONS [cons] tag= Just 1 args= [v3, v4] ->
      dup v4
      drop [v1]
      continue loop [v4]
    _builtin.NIL [nil] tag= Just 0 args= [] ->
      drop [v2]
      [__]

def TestCleanPaddedLoop  (fun args= ["v1:Boxed"] ret= Boxed)
  loop ["v2:Boxed", "v3:Boxed"] initial= [v1, [__]]
  case v2 of
    _builtin.CONS [cons] tag= Just 1 args= [v4, v5] ->
      dup v5
      drop [v2]
      continue loop [[__], v5]
    _builtin.NIL [nil] tag= Just 0 args= [] ->
      [__]

def TestCleanStructFields  (fun args= ["v1:Boxed"] ret= Boxed)
  let v2 : Ret2 =
    callRep {idris2rc2_worker_Main_k:0} ["Boxed"] -> Ret2 postDrop= [] [v1]
  case v2 of
    _builtin.CONS [cons] tag= Just 1 args= [v3, v4] ->
      con _builtin.CONS [cons] tag= Just 1 [v3, v4]
    _builtin.NIL [nil] tag= Just 0 args= [] ->
      [__]

def TestCleanReuse  (fun args= ["v1:Boxed"] ret= Boxed)
  case v1 of
    _builtin.CONS [cons] tag= Just 1 args= [v2, v3] ->
      reuseOffer v1 dupOnShared= [v2] dropOnUnique= [v3]
      con _builtin.CONS [cons] tag= Just 1 [v2, [__]] reuse= v1
    _builtin.NIL [nil] tag= Just 0 args= [] ->
      v1

def TestCleanFFI  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  let v3 : Boxed =
    dup v1
    callFFIInline ["C:f,libc,f.h"] [Int, %World] -> IORes Int postDrop= [v2] [v2, v1]
  drop [v3]
  v1

def TestCleanCallRep  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  callRep {idris2rc2_worker_Main_g:0} ["Native Int", "Boxed"] -> Boxed postDrop= [v1] [v1, v2]

def Main.charOut  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  let v3 : Boxed =
    op op_strindex [v1, v2] postDrop= [v1, v2]
  let v4 : Native Bits8 =
    callRep {idris2rc2_worker_Main_isAlpha:0} ["Native Char"] -> Native Bits8 postDrop= [v3] [v3]
  cmp ==Char [v3, #'a']
  then
    #1
  else
    #0

def TestCleanJoin  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  join j0 ["v10:Boxed", "v11:Boxed"]
  case v1 of
    _builtin.NIL [nil] tag= Just 0 args= [] ->
      jump j0 [v2, #0]
    _builtin.CONS [cons] tag= Just 1 args= [v3, v4] ->
      dup v3
      drop [v1]
      jump j0 [v2, v3]
  at j0 ->
    drop [v10]
    v11

def TestCleanJoinBorrowedField  (fun args= ["v1:Boxed"] ret= Boxed)
  join j0 ["v10:Boxed", "v11:Boxed"]
  case v1 of
    _builtin.NIL [nil] tag= Just 0 args= [] ->
      jump j0 [#0, v1]
    _builtin.CONS [cons] tag= Just 1 args= [v3, v4] ->
      jump j0 [v3, v1]
  at j0 ->
    dup v10
    drop [v11]
    v10

def TestCleanJoinImmediateParam  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Ret1 worker=True)
  join j0 ["v10:Boxed", "v11:Boxed", "v12:Boxed", "v13:Boxed"]
  case v1 of
    M.Add [datacon] tag= Just 0 args= [v3] ->
      case v2 of
        M.Add [datacon] tag= Just 0 args= [v4] ->
          jump j0 [v3, v4, v1, v2]
        _ ->
          drop [v1, v2]
          retpack _builtin.NOTHING tag= 0 []
    _ ->
      drop [v1, v2]
      retpack _builtin.NOTHING tag= 0 []
  at j0 ->
    dup v10
    dup v11
    drop [v12, v13]
    let v20 : Native Bits8 =
      callRep {eqPrim:1} ["Native Bits8", "Native Bits8"] -> Native Bits8 postDrop= [] [v10, v11]
    case v20 of
      u: 1 ->
        retpack _builtin.JUST tag= 1 [[erased]]
      u: 0 ->
        retpack _builtin.NOTHING tag= 0 []

def TestCleanJoinInLetValue  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  let v5 : Boxed =
    join j0 ["v10:Boxed"]
    case v1 of
      _builtin.NIL [nil] tag= Just 0 args= [] ->
        jump j0 [v2]
      _builtin.CONS [cons] tag= Just 1 args= [_, _] ->
        jump j0 [v2]
    at j0 ->
      dup v10
      call {f:1} [v10]
  drop [v1, v2]
  v5
