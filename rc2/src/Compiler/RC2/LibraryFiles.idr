module Compiler.RC2.LibraryFiles

import Compiler.RC2.Emit.Foreign
import Compiler.RC2.Emit.Util
import Compiler.RC2.Util

import Compiler.CompileExpr

import Core.Context

import Data.List
import Data.String

%default total

||| An include guard for the header of a library: the upper-cased name, with
||| every other character an underscore.
guardName : (name : String) -> String
guardName name = "IDRIS2RC2_LIB_" ++ pack (map (\c => if isAlphaNum c then toUpper c else '_') (unpack name)) ++ "_H"

||| Whether a type is passed or returned as an `Integer`, which needs `<gmp.h>`.
usesInteger : CFType -> Bool
usesInteger t = case peelIORes t of
                     CFInteger => True
                     _ => False

||| The header of a library: the prototype of each `%export`ed function, as
||| `Compiler.RC2.Emit.Foreign.emitExportWrapper` defines it.
export
libraryHeader : (name : String) -> List (Name, String, List CFType, CFType) -> String
libraryHeader name exports =
    let needsGmp = any (\(_, _, args, ret) => any usesInteger args || usesInteger ret) exports
        decls = map (\(_, cname, args, ret) => exportSignature False cname args ret ++ ";") exports
    in unlines $
         [ "/* The functions of " ++ name ++ " that its Idris code exports (%export), generated by rc2."
         , "   The host starts and ends the rc2 runtime: it calls idris2rc2_rtInit() once before the"
         , "   first call, idris2rc2_rtFinish() at the end, and idris2rc2_enableMultiThreading() before"
         , "   it starts a second thread (idris2rc2_runtime.h). A String result is a malloc'd copy the"
         , "   caller frees; an Integer result comes back through the leading mpz_t, which the caller"
         , "   clears (rc2/doc/export-support.md). */"
         , "#ifndef " ++ guardName name
         , "#define " ++ guardName name
         , ""
         , "#include <stddef.h>"
         , "#include <stdint.h>"
         ] ++ (if needsGmp then ["#include <gmp.h>"] else []) ++
         [ ""
         , "#ifdef __cplusplus"
         , "extern \"C\" {"
         , "#endif"
         , ""
         ] ++ decls ++
         [ ""
         , "#ifdef __cplusplus"
         , "}"
         , "#endif"
         , ""
         , "#endif"
         ]
