package rc2
version = 0.1.0
authors = "rc2 project"

sourcedir = "src"

depends = idris2, contrib, network

modules = Compiler.RC2.CC,
          Compiler.RC2.RCExp,
          Compiler.RC2.RC,
          Compiler.RC2.Reuse,
          Compiler.RC2.Loop,
          Compiler.RC2.Emit,
          Compiler.RC2.RC2,
          Main

main = Main
executable = "idris2-rc2"
