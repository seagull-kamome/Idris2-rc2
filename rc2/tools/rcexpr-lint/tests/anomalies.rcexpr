def TestUseAfterFree  (fun args= ["v1:Boxed"] ret= Boxed)
  drop [v1]
  v1

def TestDoubleDrop  (fun args= ["v1:Boxed"] ret= Boxed)
  drop [v1]
  drop [v1]
  v1

def TestBranchUseAfterFree  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  cmp ==Int [v1, v2]
  then
    drop [v1]
    v1
  else
    v2

def TestPostDropUseAfterFree  (fun args= ["v1:Boxed", "v2:Boxed"] ret= Boxed)
  let v3 : Boxed =
    op ++ [v1, v2] postDrop= [v1]
  op ++ [v3, v1] postDrop= [v3]
