-- plain keys
"ab" -> [KChar 'a', KChar 'b']
"A!" -> [KChar 'A', KChar '!']
"\r\n\t" -> [Enter, Enter, Tab]
"\DEL\b" -> [Backspace, Backspace]
"\SOH\ETX\SUB" -> [Ctrl+KChar 'a', Ctrl+KChar 'c', Ctrl+KChar 'z']
"\NUL" -> [Ctrl+KChar ' ']
"\FS\US" -> [Ctrl+KChar '\\', Ctrl+KChar '_']
-- UTF-8
"\12354\128512\233" -> [KChar '\12354', KChar '\128512', KChar '\233']
-- cursor and editing keys
"\ESC[A\ESC[B\ESC[C\ESC[D" -> [Up, Down, Right, Left]
"\ESC[H\ESC[F\ESC[2~\ESC[3~\ESC[5~\ESC[6~\ESC[1~\ESC[4~" -> [Home, End, Insert, Delete, PageUp, PageDown, Home, End]
"\ESC[Z" -> [Shift+BackTab]
"\ESC[15~\ESC[17~\ESC[24~" -> [F5, F6, F12]
"\ESCOP\ESCOS\ESCOA" -> [F1, F4, Up]
-- modifiers
"\ESC[1;5C\ESC[1;2A\ESC[1;3D\ESC[3;5~\ESC[1;8H" -> [Ctrl+Right, Shift+Up, Alt+Left, Ctrl+Delete, Ctrl+Alt+Shift+Home]
"\ESCx\ESC\ESC\ESC\12354" -> [Alt+KChar 'x', Alt+Escape, Alt+KChar '\12354']
-- escape and incomplete input
"\ESC" -> []  rest=[27]
"\ESC" (final) -> [Escape]
"a\ESC[" -> [KChar 'a']  rest=[27, 91]
"a\ESC[" (final) -> [KChar 'a']
"\ESC[1;" -> []  rest=[27, 91, 49, 59]
"\ESCO" -> []  rest=[27, 79]
"\ESCO" (final) -> []
[227, 129] -> []  rest=[227, 129]
[227, 129] (final) -> [KChar '\65533']
[227, 129, 130, 97] -> [KChar '\12354', KChar 'a']
[255, 97] -> [KChar '\65533', KChar 'a']
[227, 97, 98] -> [KChar '\65533', KChar 'a', KChar 'b']
[195, 27, 91, 65] -> [KChar '\65533', Up]
[227, 129, 97] (final) -> [KChar '\65533', KChar 'a']
-- bracketed paste
"\ESC[200~hello\nworld\ESC[201~x" -> [Paste "hello\nworld", KChar 'x']
"\ESC[200~\12354\12356\ESC[201~" -> [Paste "\12354\12356"]
"\ESC[200~partial" -> []  rest=[27, 91, 50, 48, 48, 126, 112, 97, 114, 116, 105, 97, 108]
"\ESC[200~partial" (final) -> [Paste "partial"]
"\ESC[200~\ESC[201~" -> [Paste ""]
-- mouse
"\ESC[<0;10;5M\ESC[<0;10;5m" -> [Mouse Left down at 9,4, Mouse Left up at 9,4]
"\ESC[<1;1;1M\ESC[<2;3;4M" -> [Mouse Middle down at 0,0, Mouse Right down at 2,3]
"\ESC[<32;7;8M\ESC[<35;7;9M" -> [Mouse Left drag at 6,7, Mouse NoButton move at 6,8]
"\ESC[<64;1;1M\ESC[<65;2;2M\ESC[<66;2;2M" -> [Mouse WheelUp down at 0,0, Mouse WheelDown down at 1,1]
"\ESC[<4;1;1M\ESC[<8;1;1M\ESC[<16;1;1M\ESC[<28;1;1M" -> [Mouse Shift+Left down at 0,0, Mouse Alt+Left down at 0,0, Mouse Ctrl+Left down at 0,0, Mouse Ctrl+Alt+Shift+Left down at 0,0]
"\ESC[<0;10;5" -> []  rest=[27, 91, 60, 48, 59, 49, 48, 59, 53]
"\ESC[<0;10M" -> []
"x\ESC[<0;120;45My" -> [KChar 'x', Mouse Left down at 119,44, KChar 'y']
-- ignored
"\ESC[99~q" -> [KChar 'q']
"\ESC[?1;2cq" -> [KChar 'q']
-- split across reads
[KChar 'x']  rest=[27, 91, 49, 59] | [Ctrl+Up, KChar 'y']
