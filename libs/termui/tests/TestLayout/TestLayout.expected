|abcde
|fghij
|kl
-- truncate
|truncate
-- wide characters
|┌────────┐
|│日本語ab│
|└────────┘
-- wide char cut by the edge
|あい
-- shrink
|┌───┐┌───┐
|│   ││   │
|└───┘└───┘
-- percent + margin
|┌────────┐
|│        │ ┌──────┐
|│        │ │      │
|│        │ └──────┘
|└────────┘
-- clip to the box
|┌────┐
|│over│
|└────┘
|tail
|
-- row of wrapping texts keeps the height
|aaaacccc
|bbbbdddd
|end
|
-- leading spaces
|  abc
|defgh
|
-- trailing newline
|abc
|
|
-- shrink: a rigid sibling cannot absorb
|┌─────────
|│
|└─────────
-- shrink saturates, the rest is redistributed
|┌──────────────────┐
|│                  │
|└──────────────────┘
-- justify around
|  a    b
-- child does not overwrite the parent border
|┌────┐
|│    │
|└────┘
|
-- truncated and char-wrapped
|trunca
|wrap m
|e plea
|se
