-- menu moves
open: active=0 open=True cursor=0 chose=[]
down, down: active=0 open=True cursor=3 chose=[]
down past the separator: active=0 open=True cursor=0 chose=[]
wrap down: active=0 open=True cursor=1 chose=[]
wrap up: active=0 open=True cursor=3 chose=[]
up when closed: active=0 open=False cursor=0 chose=[]
down when closed opens: active=0 open=True cursor=0 chose=[]
next, open: active=1 open=True cursor=0 chose=[]
prev wraps: active=1 open=False cursor=0 chose=[]
next wraps: active=0 open=False cursor=0 chose=[]
activate chooses: active=0 open=False cursor=1 chose=["Chose save"]
activate when closed opens: active=0 open=True cursor=0 chose=[]
close: active=0 open=False cursor=0 chose=[]
