O_APPEND=1024
O_ASYNC=8192
O_CLOEXEC=524288
O_CREAT=64
O_DIRECTORY=65536
O_DSYNC=4096
O_EXCL=128
O_NOCTTY=256
O_NOFOLLOW=131072
O_NONBLOCK=2048
O_SYNC=1052672
O_TRUNC=512
O_RDONLY=0
O_WRONLY=1
O_RDWR=2
AT_SYMLINK_NOFOLLOW=256
write: Right 12
fsync: Right ()
fdatasync: Right ()
SEEK_CUR: Right 12
SEEK_SET: Right 3
SEEK_END: Right 10
close: Right ()
Buffer.read: Right 12 "hello world\n"
write to a read-only descriptor is EBADF: True
fallocate read-only is EBADF: True
AnyPtr.read: Right 5
dup: ok
dup2: 99
Buffer.write: Right 3
flockShared: Right ()
flockExclude: Right ()
funlock: Right ()
lockf: Right ()
lockfTest: Right ()
lockfUnlock: Right ()
lockfTestAndLock: Right ()
lockfUnlock: Right ()
fchmod: Right ()
fchown: Right ()
fallocate: Right ()
close: Right ()
chmod missing is ENOENT: True
chmod: Right ()
chown: Right ()
lchown: Right ()
fchmodat: Right ()
fchownat: Right ()
openat+close: Right ()
close dir: Right ()
errno: True
-- stat
size=5 nlink=1
regular=True dir=False link=False fifo=False
mode bits type=True
fstat same inode: True
dir is directory: True
stat missing: errno 2
mtime is positive: True
-- path
mkdir: ok
mkdir again: errno 17
sub is directory: True
rmdir: ok
symlink: ok
readlink: Right "file.txt"
lstat is symlink: True
stat follows the link: True
link: ok
nlink after link: 2
unlink hard: ok
unlink lnk: ok
mkfifo: ok
fifo: True
unlink fifo: ok
realpath ends with: True
realpath missing: errno 2
mkstemp name: True
unlink temp: ok
mkdtemp is directory: True
rmdir temp: ok
-- access/truncate/umask/utimensat
access F_OK: ok
access R_OK: ok
access missing: errno 2
truncate: ok
size after truncate: 2
ftruncate: ok
size after ftruncate: 9
umask restored: True
utimensat: ok
atime=TimeSpec 1000000000 500 mtime=TimeSpec 1500000000 0
utimensat omit: ok
atime kept: True, mtime now: True
-- fnmatch, glob
fnmatch *.txt file.txt flags 0: True
fnmatch *.txt file.bin flags 0: False
fnmatch f?le.t[a-z]t file.txt flags 0: True
fnmatch * .hidden flags 0: True
fnmatch * .hidden flags 4: False
fnmatch a* a/b flags 0: True
fnmatch a* a/b flags 1: False
fnmatch \* * flags 0: True
fnmatch \* \* flags 2: True
glob *.txt: Right ["TestPosixFile.scratch/file.txt"]
glob no match: Right []
glob no match, NOCHECK: Right ["TestPosixFile.scratch/nothing*"]
glob directory, MARK: Right ["TestPosixFile.scratch/"]
done
perror-test: No such file or directory
