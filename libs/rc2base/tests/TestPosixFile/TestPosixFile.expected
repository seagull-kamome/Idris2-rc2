O_APPEND=1024
O_ASYNC=8192
O_CLOEXEC=524288
O_CREAT=64
O_DIRECTORY=65536
O_DSYNC=4096
O_EXCL=128
O_NOCTTY=256
O_NOFOLLOW=131072
O_NONBLOCK=2048
O_SYNC=1052672
O_TRUNC=512
AT_SYMLINK_NOFOLLOW=256
write: 12
fsync: 0
fdatasync: 0
SEEK_CUR: 12
SEEK_SET: 3
SEEK_END: 10
close: 0
Buffer.read: 12 "hello world\n"
AnyPtr.read: 5
dup: ok
dup2: 99
Buffer.write: 3
flockShared: 0
flockExclude: 0
funlock: 0
lockf: 0
lockfTest: 0
lockfUnlock: 0
lockfTestAndLock: 0
lockfUnlock: 0
fchmod: 0
fchown: 0
fallocate: 0
close: 0
chmod: 0
chown: 0
lchown: 0
fchmodat: 0
fchownat: 0
openat+close: 0
close dir: 0
errno: True
-- stat
size=5 nlink=1
regular=True dir=False link=False fifo=False
mode bits type=True
fstat same inode: True
dir is directory: True
stat missing: errno 2
mtime is positive: True
-- path
mkdir: ok
mkdir again: errno 17
sub is directory: True
rmdir: ok
symlink: ok
readlink: Right "file.txt"
lstat is symlink: True
stat follows the link: True
link: ok
nlink after link: 2
unlink hard: ok
unlink lnk: ok
mkfifo: ok
fifo: True
unlink fifo: ok
realpath ends with: True
realpath missing: errno 2
mkstemp name: True
unlink temp: ok
mkdtemp is directory: True
rmdir temp: ok
-- access/truncate/umask/utimensat
access F_OK: ok
access R_OK: ok
access missing: errno 2
truncate: ok
size after truncate: 2
ftruncate: ok
size after ftruncate: 9
umask restored: True
utimensat: ok
atime=TimeSpec 1000000000 500 mtime=TimeSpec 1500000000 0
utimensat omit: ok
atime kept: True, mtime now: True
-- fnmatch, glob
fnmatch *.txt file.txt flags 0: True
fnmatch *.txt file.bin flags 0: False
fnmatch f?le.t[a-z]t file.txt flags 0: True
fnmatch * .hidden flags 0: True
fnmatch * .hidden flags 4: False
fnmatch a* a/b flags 0: True
fnmatch a* a/b flags 1: False
fnmatch \* * flags 0: True
fnmatch \* \* flags 2: True
glob *.txt: Right ["TestPosixFile.scratch/file.txt"]
glob no match: Right []
glob no match, NOCHECK: Right ["TestPosixFile.scratch/nothing*"]
glob directory, MARK: Right ["TestPosixFile.scratch/"]
done
perror-test: No such file or directory
