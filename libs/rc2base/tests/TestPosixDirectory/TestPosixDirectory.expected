DT_BLK=6
DT_CHR=2
DT_DIR=4
DT_FIFO=1
DT_LINK=10
DT_REG=8
DT_SOCK=12
DT_UNKNOWN=0
PATH_MAX=4096
entry . 4 True
entry .. 4 True
entry a 8 True
entry b 8 True
entry link 10 True
entry sub 4 True
opendir missing is ENOENT: True
fdopendir of a file is ENOTDIR: True
dirfd ok: True
closedir: Right ()
closedir fdopendir: Right ()
chdir: Right ()
getcwd in scratch: True
fchdir: Right ()
back to start: True
chroot missing: Left Errno:2
chdir missing: Left Errno:2
done
