-- System.Posix.Errno: every errno constant (each a "CExpr:" template over
-- <errno.h>) is printed with `show` and compared, through the .expected
-- file, with the values a plain C program prints for the same macros on
-- Linux. Also exercises errno / strerror and the Eq/Ord
-- instances.

import System.Posix.Errno

main : IO ()
main = do
  putStrLn ("E2BIG=" ++ show E2BIG)
  putStrLn ("EACCES=" ++ show EACCES)
  putStrLn ("EADDRINUSE=" ++ show EADDRINUSE)
