  putStrLn ("EXDEV=" ++ show EXDEV)
  putStrLn ("EXFULL=" ++ show EXFULL)
  putStrLn ("EDEADLOCK=" ++ show EDEADLOCK)
  printLn (ENOENT == ENOENT, ENOENT == EPERM, compare EPERM ENOENT, compare ENOENT EPERM)
  s <- strerror 2
  putStrLn s
  s2 <- strerror 99999
  putStrLn s2
  e <- errno
  putStrLn (if e == e then "errno ok" else "errno changed")
