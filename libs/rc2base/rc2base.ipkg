package rc2base

version    = 0.1.0
opts       = "--total"
sourcedir  = "src"
depends    = contrib, network
modules    = Data.TextBuffer, Data.Text, Data.Buffer.RC2, Data.Double.RC2,
             Data.Integer.GMP,
             Data.String.FFI,
             Network.HTTP.Route, Network.HTTP.Router, Network.HTTP.Server,
             System.Concurrency.RC2,
             System.FFI.C.Array, System.FFI.C.Ptr, System.FFI.C.Sizeof,
             System.IO.MemStream,
             System.Net.Epoll,
             System.Random.Xoroshiro128PlusPlus,
             System.Random.Xoroshiro64StarStar,
             Text.Regex.RE2
-- `support/c`'s own Makefile also needs `re2`/`pkg-config`/a C++
-- compiler on PATH (for Text.Regex.RE2's own shim) -- see
-- doc/regex.md's "Build requirements". Not optional: `prebuild`
-- failing there fails this whole package's build, same as any other
-- support/c compile error.
prebuild   = "make -C support/c"
postclean  = "make -C support/c clean"

-- Idris2's own packaging convention (docs/source/reference/packages.rst,
-- "Support file install directories"): a package's install root has two
-- specially-treated subdirectories, `lib` (compiled libraries) and
-- `data` -- but idris2 --install only creates the install root itself
-- and copies .ttc/.ttm/.ipkg there; it never knows to create `lib` or
-- populate it, so a postinstall hook has to do that itself. Note this
-- only gets picked up *automatically* by the Chez/Racket backends'
-- .so dlopen mechanism -- rc2 (like upstream RefC) still needs the
-- consumer to point IDRIS2_LIBS/IDRIS2_CFLAGS/IDRIS2_LDFLAGS at this
-- directory manually (see README.md's "Build & test" section).
postinstall = "make -C support/c install"
