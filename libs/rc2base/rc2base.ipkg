package rc2base

version    = 0.1.0
opts       = "--total"
sourcedir  = "src"
depends    = contrib, network
modules    = Control.Concurrent.MVar,
             Control.Concurrent.Atomic,
             Control.Task, Control.Task.Epoll, Control.Task.Pool, Control.Task.Scheduler, Control.Task.Source,
             Data.TextBuffer, Data.Text, Data.Double.RC2,
             Data.Double.Convert,
             Data.IORef.RC2,
             Data.Integer.GMP,
             Data.Queue,
             Data.String.FFI, Data.String.RC2,
             Language.RCExpr.AST, Language.RCExpr.Lexer, Language.RCExpr.Parser,
             --
             Network.HTTP.Client, Network.HTTP.Client.Curl, Network.HTTP.Client.Curl.Raw, Network.HTTP.Client.Curl.TextBuffer,
             Network.HTTP.Client.Curl.Types,
             Network.HTTP.Client.WebAPI.AI.OpenAI, Network.HTTP.Client.WebAPI.AI.Providers,
             Network.HTTP.Client.WebAPI.Auth.OAuth2, Network.HTTP.Client.WebAPI.Auth.PKCE,
             Network.HTTP.Client.WebAPI.JSON,
             --
             Network.HTTP.Route, Network.HTTP.Router, Network.HTTP.Server,
             Network.URL,
             --
             Network.RC2,
             System.Concurrency.RC2,
             System.Console.Xterm,
             System.FFI.C.Array, System.FFI.C.Memory, System.FFI.C.Null, System.FFI.C.Ptr,
             System.FFI.C.Sizeof,
             System.GC.RC2,
             System.Linux.Clock, System.Linux.Copy, System.Linux.Dl, System.Linux.Eventfd, System.Linux.Memfd, System.Linux.Prctl, System.Linux.Process, System.Linux.Random, System.Linux.Statx, System.Linux.Epoll, System.Linux.Inotify, System.Linux.Pipe, System.Linux.Signalfd, System.Linux.Timerfd,
             --
             System.Posix.Directory, System.Posix.Dl, System.Posix.Errno, System.Posix.Fcntl, System.Posix.FileDesc, System.Posix.Poll,
             System.Posix.File, System.Posix.Mmap,
             System.Posix.Process, System.Posix.Signal,
             System.Posix.Pwd, System.Posix.Glob, System.Posix.Select, System.Posix.Syslog,
             System.Posix.Path, System.Posix.Stat, System.Posix.Stdio, System.Posix.Time,
             System.Posix.Uio, System.Posix.Termios,
             --
             System.Random.Xoroshiro128PlusPlus,
             System.Random.Xoroshiro64StarStar,
             Text.Encoding.UTF8,
             Text.Regex.POSIX
-- `support/c`'s Makefile builds `libidris2rc2base.a` with a plain C
-- toolchain (`gcc`/`ar`) -- no `pkg-config`/C++/re2. The RE2 regex
-- bindings that used to need those now live in their own package,
-- `libs/text-re2`.
prebuild   = "make -C support/c"
postclean  = "make -C support/c clean"

-- Idris2's own packaging convention (docs/source/reference/packages.rst,
-- "Support file install directories"): a package's install root has two
-- specially-treated subdirectories, `lib` (compiled libraries) and
-- `data` -- but idris2 --install only creates the install root itself
-- and copies .ttc/.ttm/.ipkg there; it never knows to create `lib` or
-- populate it, so a postinstall hook has to do that itself. Note this
-- only gets picked up *automatically* by the Chez/Racket backends'
-- .so dlopen mechanism -- rc2 (like upstream RefC) still needs the
-- consumer to point IDRIS2_LIBS/IDRIS2_CFLAGS/IDRIS2_LDFLAGS at this
-- directory manually (see README.md's "Build & test" section).
postinstall = "make -C support/c install"
